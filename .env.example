PORT=4000
MONGO_URI=mongodb://localhost:27017/your_database_name
USER_PER_PAGE=10
PROPERTY_PER_PAGE=6
JWT_SECRET=your_jwt_secret_here
# OTP SMS via Fast2SMS (https://docs.fast2sms.com/reference/send-otp) — get the
# API key from the Dev API section of your Fast2SMS account, and otp_id from
# your approved OTP DLT template
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_OTP_TEMPLATE_ID=your_fast2sms_otp_template_id
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLIENT_URL=http://localhost:5173

# Required for correct canonical URLs, OG tags, and sitemap.xml/robots.txt in production
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

